# Copy to .env for local runs (docker/compose) or set these in the Northflank UI.
# These are the ONLY secrets. There are NO exchange/trading keys — by design.

TELEGRAM_TOKEN=123456:your-bot-token-from-BotFather
TELEGRAM_CHAT_ID=your-numeric-chat-id

# Optional: override the config file path
# CONFIG_PATH=config.yaml
